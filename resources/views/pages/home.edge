<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      My Tasks
    </title>
    <script src="https://cdn.tailwindcss.com">

    </script>
    {{-- Alpine.js --}}
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js">

    </script>
    {{-- Font Awesome for Icons --}}
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <style>
      [x-cloak] {
        display: none !important;
      }
    </style>
  </head>
  <body class="bg-gray-100 p-8" x-data="taskApp()">
    <div class="max-w-4xl mx-auto">
      <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold">
          My Tasks
        </h1>
        <button
          @click="toggleForm()"
          id="toggleBtn"
          class="text-white px-6 py-2 rounded-lg font-semibold transition"
          :class="formVisible ? 'bg-red-600 hover:bg-red-700' : 'bg-blue-600 hover:bg-blue-700'"
        >
          <template x-if="!formVisible">
            <span>              <i class="fas fa-plus mr-2"></i>Create New Task</span>
          </template>
          <template x-if="formVisible">
            <span>              <i class="fas fa-times mr-2"></i>Close Form</span>
          </template>
        </button>
      </div>

      {{-- Create Task Form (Hidden by default) --}}
      <div id="taskForm" class="bg-white p-6 rounded-lg shadow-lg mb-6" x-show="formVisible" x-cloak>
        <h2 class="text-xl font-semibold mb-4">
          Create New Task
        </h2>
        <form action="/api/simple/tasks" method="POST" @submit.prevent="handleSubmit">
          <div class="space-y-4">
            {{-- Title --}}
            <div>
              <label for="title" class="block text-sm font-medium text-gray-700 mb-1">
                Title <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="title"
                name="title"
                required
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                placeholder="Enter task title"
              />
            </div>

            {{-- Description --}}
            <div>
              <label for="description" class="block text-sm font-medium text-gray-700 mb-1">
                Description
              </label>
              <textarea
                id="description"
                name="description"
                rows="3"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                placeholder="Enter task description (optional)"
              ></textarea>
            </div>

            {{-- Priority --}}
            <div>
              <label for="priority" class="block text-sm font-medium text-gray-700 mb-1">
                Priority
              </label>
              <select
                id="priority"
                name="priority"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              >
                <option value="0">
                  Low
                </option>
                <option value="1">
                  Medium
                </option>
                <option value="2">
                  High
                </option>
              </select>
            </div>

            {{-- Tags --}}
            <div>
              <label for="tag_ids" class="block text-sm font-medium text-gray-700 mb-1">
                Tags (comma-separated IDs, optional)
              </label>
              <input
                type="text"
                id="tag_ids"
                name="tag_ids"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                placeholder="e.g., 1,2,3"
              />
            </div>

            {{-- Buttons --}}
            <div class="flex gap-3">
              <button
                type="submit"
                class="bg-green-600 hover:bg-green-700 text-white px-6 py-2 rounded-lg font-semibold transition"
              >
                <i class="fas fa-check mr-2"></i>Create Task
              </button>
              <button
                type="button"
                @click="toggleForm()"
                class="bg-gray-300 hover:bg-gray-400 text-gray-800 px-6 py-2 rounded-lg font-semibold transition"
              >
                <i class="fas fa-times mr-2"></i>Cancel
              </button>
            </div>
          </div>
        </form>

        {{-- Success/Error Messages --}}
        <div
          x-show="message.text"
          class="mt-4"
          :class="message.type === 'success' ? 'p-4 bg-green-100 text-green-800 rounded-lg' : 'p-4 bg-red-100 text-red-800 rounded-lg'"
          x-text="message.text"
        >
        </div>
      </div>

      {{-- Tasks List --}}
      @if(tasks.length > 0)
        <div class="space-y-4">
          @each(task in tasks)
            <div class="bg-white p-4 rounded-lg shadow">
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <h2
                    class="text-xl font-semibold {{ task.isCompleted ? 'line-through text-gray-500' : 'text-gray-800' }}"
                  >
                    {{ task.title }}
                  </h2>

                  @if(task.description)
                    <p class="text-gray-600 mt-2">
                      {{ task.description }}
                    </p>
                  @end
                  
                  {{-- Display tags --}}
                  @if(task.tags && task.tags.length > 0)
                    <div class="flex gap-2 mt-3">
                      @each(tag in task.tags)
                        <span class="bg-blue-100 text-blue-800 text-xs px-2 py-1 rounded">
                          {{ tag.name }}
                      </span>
                      @end
                    </div>
                  @end
                  
                  <div class="mt-3 text-sm text-gray-500">
                    Priority:
                    @if(task.priority === 0)
                      <span class="text-green-600 font-medium">                        <i class="fas fa-arrow-down mr-1"></i>Low</span>
                    @elseif(task.priority === 1)
                      <span class="text-yellow-600 font-medium">                        <i class="fas fa-minus mr-1"></i>Medium</span>
                    @elseif(task.priority === 2)
                      <span class="text-red-600 font-medium">                        <i class="fas fa-arrow-up mr-1"></i>High</span>
                    @else
                      <span class="text-gray-600">{{ task.priority || 0 }}</span>
                    @end
                    | 
                    <i class="far fa-calendar"></i>Created: {{ task.createdAt.setZone('UTC+7').toFormat('MMM dd, yyyy h:mm a ZZZZ') }}
                  </div>
                </div>

                <div class="flex flex-col items-end gap-3">
                  @if(task.isCompleted)
                    <span class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm">
                      <i class="fas fa-check-circle mr-2"></i>Done
                    </span>
                  @else
                    <span class="bg-yellow-100 text-yellow-800 px-3 py-1 rounded-full text-sm">
                      <i class="fas fa-clock mr-2"></i>Pending
                    </span>
                  @end
                  <div class="flex flex-row item-center gap-2">
                    <i class="fas fa-trash text-red-600 cursor-pointer text-2xl" @click="deleteTask({{ task.id }})"></i>
                    <input type="checkbox" @click="toggleComplete({{ task.id }})" {{ task.isCompleted ? 'checked' : '' }} />
                  </div>
                </div>
              </div>
            </div>
          @end
        </div>
      @else
        <div class="bg-white p-8 rounded-lg shadow text-center">
          <p class="text-gray-500 text-lg">
            No tasks found. Create your first task!
          </p>
        </div>
      @end
      
      {{-- Stats section --}}
      <div class="mt-8 bg-white p-6 rounded-lg shadow">
        <h3 class="text-lg font-semibold mb-4">
          Statistics
        </h3>
        <div class="grid grid-cols-3 gap-4 text-center">
          <div>
            <div class="text-3xl font-bold text-gray-800">
              {{ tasks.length }}
            </div>
            <div class="text-gray-600">
              Total
            </div>
          </div>
          <div>
            <div class="text-3xl font-bold text-green-600">
              {{ tasks.filter(t => t.isCompleted).length }}
            </div>
            <div class="text-gray-600">
              Completed
            </div>
          </div>
          <div>
            <div class="text-3xl font-bold text-yellow-600">
              {{ tasks.filter(t => !t.isCompleted).length }}
            </div>
            <div class="text-gray-600">
              Pending
            </div>
          </div>
        </div>
      </div>
    </div>

    {{-- Alpine.js Component --}}
    <script>
      function taskApp() {
        return {
          formVisible: false,
          message: {
            text: "",
            type: ""
          },
          toggleForm() {
            this.formVisible = !this.formVisible;
            if (!this.formVisible) {
              // Reset form
              this.$el.querySelector("form").reset();
              this.message = {
                text: "",
                type: ""
              };
            }
          },
          async handleSubmit(event) {
            const form = event.target;
            const formData = new FormData(form);
            // Convert tag_ids from comma-separated string to array
            const tagIdsString = formData.get("tag_ids");
            const tagIds = tagIdsString ? tagIdsString.split(",").map(id => parseInt(id.trim())).filter(id => !isNaN(id)) : [];
            // Prepare data
            const data = {
              title: formData.get("title"),
              description: formData.get("description"),
              priority: parseInt(formData.get("priority")),
              tag_ids: tagIds
            };
            try {
              const response = await fetch("/api/simple/tasks", {
                method: "POST",
                headers: {
                  "Content-Type": "application/json"
                },
                body: JSON.stringify(data)
              });
              const result = await response.json();
              if (response.ok) {
                this.showMessage("Task created successfully! Refreshing...", "success");
                setTimeout(() => {
                  window.location.reload();
                }, 1e3);
              } else {
                this.showMessage("Error creating task: " + (result.message || "Unknown error"), "error");
              }
            } catch (error) {
              this.showMessage("Error: " + error.message, "error");
            }
          },
          async deleteTask(taskId) {
            if (!confirm("Are you sure you want to delete this task?")) {
              return;
            }
            try {
              const response = await fetch(`/api/simple/tasks/${taskId}`, {
                method: "DELETE"
              });
              const result = await response.json();
              if (response.ok) {
                this.showMessage("Task deleted successfully! Refreshing...", "success");
                setTimeout(() => {
                  window.location.reload();
                }, 1e3);
              } else {
                this.showMessage("Error deleting task: " + (result.message || "Unknown error"), "error");
              }
            } catch (error) {
              this.showMessage("Error: " + error.message, "error");
            }
          },
          async toggleComplete(taskId) {
            try {
              const response = await fetch(`/api/simple/tasks/${taskId}/toggle`, {
                method: "PATCH"
              });
              const result = await response.json();
              if (response.ok) {
                this.showMessage("Task status updated! Refreshing...", "success");
                setTimeout(() => {
                  window.location.reload();
                }, 1e3);
              } else {
                this.showMessage("Error updating task: " + (result.message || "Unknown error"), "error");
              }
            } catch (error) {
              this.showMessage("Error: " + error.message, "error");
            }
          },
          showMessage(text, type) {
            this.message = {
              text: text,
              type: type
            };
          }
        };
      }
    </script>
  </body>
</html>
